# Track application sources only. Employee backups, populated spreadsheets,
# browser exports, temporary previews and installed dependencies stay local.
*
!/.gitignore
!/README.md
!/index.html
!/vercel.json
!/.vercelignore
!/Kordoc_연결실행.cmd
!/범용양식_사용안내.md
!/인구전략위원회_조직구성.json
!/인구전략위원회_조직연락망.html
!/인구전략위원회_직원현황.html
!/조직연락망_범용양식.html
!/직원현황_범용양식.html
!/kordoc-bridge/
/kordoc-bridge/*
!/kordoc-bridge/package.json
!/kordoc-bridge/package-lock.json
!/kordoc-bridge/*.js
!/kordoc-bridge/*.mjs
!/kordoc-bridge/사용안내.md
!/tests/
/tests/*
!/tests/*.cjs
